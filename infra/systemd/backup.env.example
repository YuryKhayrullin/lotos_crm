# Root-owned 0600 /etc/lotos/backup-staging.env; a DIFFERENT repo/password for production.
# Must be OUTSIDE this VPS: reviewed SFTP host or private object storage bucket.
RESTIC_REPOSITORY=REPLACE_WITH_OFFSITE_REPOSITORY
RESTIC_PASSWORD_FILE=/etc/lotos/restic-staging.password
RESTIC_CACHE_DIR=/var/cache/lotos/restic-staging
# Provider credentials, if needed, also belong ONLY in this private file.
