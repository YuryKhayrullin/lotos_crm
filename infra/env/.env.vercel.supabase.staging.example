# Copy to .env.vercel.staging.local, owned mode 0600; dedicated NEW staging project.
APP_ENV=staging
DEPLOY_TARGET=vercel
CRM_BACKEND=postgres
APP_URL=https://YOUR-STAGING-PROJECT.vercel.app
CLOUD_DATABASE_PROVIDER=supabase
# Acknowledgement only; verify the selected project in Dashboard before migration.
CLOUD_DATABASE_ISOLATED=true
CLOUD_SUPABASE_PROJECT_REF=REPLACE_WITH_EXACT_20_LETTER_PROJECT_REF
# Copy the exact shared pooler hostname from Supabase Connect.
CLOUD_DATABASE_HOST=aws-0-eu-central-1.pooler.supabase.com
CLOUD_DATABASE_DIRECT_HOST=aws-0-eu-central-1.pooler.supabase.com
# Vercel serverless runtime uses Transaction mode (6543), migrations use Session (5432).
DATABASE_URL=postgresql://lotos_runtime.YOUR_PROJECT_REF:REPLACE_WITH_DISTINCT_64_HEX_RUNTIME_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Operator-only, session pooler (5432) preserves migration advisory locks.
DIRECT_URL=postgresql://lotos_migrator.YOUR_PROJECT_REF:REPLACE_WITH_DISTINCT_64_HEX_MIGRATOR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Base64 of the downloaded Supabase database CA PEM; no file path or private key.
CLOUD_DATABASE_CA_BASE64=REPLACE_WITH_BASE64_CA_CERTIFICATE
BETTER_AUTH_SECRET=REPLACE_WITH_DISTINCT_64_HEX_AUTH_SECRET
DOCUMENT_STORAGE=disabled
COACH_REGISTRATION_ENABLED=false
TRUSTED_PROXY=vercel
