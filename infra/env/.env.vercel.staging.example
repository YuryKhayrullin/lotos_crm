# Copy to .env.vercel.staging.local (0600); no real credentials in Git.
# Dedicated fictional staging only. Do NOT use the existing GAS/Supabase data.
APP_ENV=staging
DEPLOY_TARGET=vercel
CLOUD_DATABASE_PROVIDER=neon
CRM_BACKEND=postgres
APP_URL=https://YOUR-STAGING-PROJECT.vercel.app
CLOUD_DATABASE_HOST=YOUR-ENDPOINT-pooler.eu-central-1.aws.neon.tech
CLOUD_DATABASE_DIRECT_HOST=YOUR-ENDPOINT.eu-central-1.aws.neon.tech
DATABASE_URL=postgresql://lotos_runtime:REPLACE_WITH_DISTINCT_64_HEX_RUNTIME_PASSWORD@YOUR-ENDPOINT-pooler.eu-central-1.aws.neon.tech:5432/lotos_crm_staging?sslmode=verify-full
# DIRECT_URL only for private operator commands, NEVER in Vercel runtime env.
DIRECT_URL=postgresql://lotos_migrator:REPLACE_WITH_DISTINCT_64_HEX_MIGRATOR_PASSWORD@YOUR-ENDPOINT.eu-central-1.aws.neon.tech:5432/lotos_crm_staging?sslmode=verify-full
BETTER_AUTH_SECRET=REPLACE_WITH_DISTINCT_64_HEX_AUTH_SECRET
# Temporary staging: no receipt upload/download or object storage required.
DOCUMENT_STORAGE=disabled
COACH_REGISTRATION_ENABLED=false
TRUSTED_PROXY=vercel
