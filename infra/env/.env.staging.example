# Template only. Owner-selected VPS/domain and a passed release gate required.
APP_ENV=staging
NODE_ENV=production
CRM_BACKEND=postgres
COACH_REGISTRATION_ENABLED=false
TRUSTED_PROXY=caddy
APP_URL=https://staging.crm.example
CRM_DOMAIN=staging.crm.example
ACME_EMAIL=REPLACE_WITH_CONTACT_EMAIL
# Immutable local image IDs or registry references with @sha256 digest.
APP_IMAGE=
MIGRATOR_IMAGE=
POSTGRES_DB=lotos_crm_staging
POSTGRES_PASSWORD=REPLACE_WITH_SEPARATE_OWNER_64_HEX_PASSWORD
RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_64_HEX_PASSWORD
MIGRATOR_PASSWORD=REPLACE_WITH_MIGRATOR_64_HEX_PASSWORD
BACKUP_PASSWORD=REPLACE_WITH_BACKUP_64_HEX_PASSWORD
DATABASE_URL=postgresql://lotos_runtime:REPLACE_WITH_UNIQUE_64_HEX_PASSWORD@db:5432/lotos_crm_staging
DIRECT_URL=postgresql://lotos_migrator:REPLACE_WITH_SEPARATE_MIGRATION_PASSWORD@db:5432/lotos_crm_staging
# Generate a unique 32-byte secret as 64 lowercase hex characters.
BETTER_AUTH_SECRET=
RECEIPTS_ROOT=/var/lib/lotos/staging/receipts
# Private persistent volume, separate from production.
DOCUMENTS_DIR=/var/lib/lotos-crm/documents/staging
BACKUPS_DIR=/var/lib/lotos-crm/backups/staging
