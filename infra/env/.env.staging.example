# Template only. Do not connect or deploy until PostgreSQL backend is ready.
APP_ENV=staging
NODE_ENV=production
CRM_BACKEND=postgres
COACH_REGISTRATION_ENABLED=false
TRUSTED_PROXY=none
APP_URL=https://staging.crm.example
DATABASE_URL=postgresql://lotos_runtime:REPLACE_WITH_UNIQUE_64_HEX_PASSWORD@db:5432/lotos_crm_staging
DIRECT_URL=postgresql://lotos_migrator:REPLACE_WITH_SEPARATE_MIGRATION_PASSWORD@db:5432/lotos_crm_staging
# Generate a unique 32-byte secret as 64 lowercase hex characters.
BETTER_AUTH_SECRET=
RECEIPTS_ROOT=/var/lib/lotos/staging/receipts
# Private persistent volume, separate from production.
DOCUMENTS_DIR=/var/lib/lotos-crm/documents/staging
