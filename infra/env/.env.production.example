# Template only. Production configuration must never be used by local/tests.
APP_ENV=production
NODE_ENV=production
CRM_BACKEND=postgres
COACH_REGISTRATION_ENABLED=false
TRUSTED_PROXY=none
APP_URL=https://crm.example
DATABASE_URL=postgresql://lotos_runtime:REPLACE_WITH_UNIQUE_64_HEX_PASSWORD@db:5432/lotos_crm_production
DIRECT_URL=postgresql://lotos_migrator:REPLACE_WITH_SEPARATE_MIGRATION_PASSWORD@db:5432/lotos_crm_production
# Generate a unique 32-byte secret as 64 lowercase hex characters.
BETTER_AUTH_SECRET=
RECEIPTS_ROOT=/var/lib/lotos/production/receipts
# Private persistent volume, separate from staging. No public/static directory.
DOCUMENTS_DIR=/var/lib/lotos-crm/documents/production
