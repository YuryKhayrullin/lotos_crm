# Legacy GAS runtime only. New isolated PostgreSQL setup: docs/ENVIRONMENTS.md.
# Do not reuse working GAS credentials in local PostgreSQL tests or staging.
CRM_BACKEND=gas
GAS_WEBAPP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GAS_HMAC_SECRET=replace-with-a-new-32-byte-secret
SESSION_SECRET=replace-with-a-different-32-byte-secret
UPSTASH_REDIS_REST_URL=https://your-rate-limit-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-a-server-only-token
GAS_TIMEOUT_MS=30000
