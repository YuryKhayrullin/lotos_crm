{
  "name": "lotos-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsc --target ES2020 --module commonjs --moduleResolution node --skipLibCheck --outDir .test-dist lib/utils/date-core.ts lib/server/policy.ts && node --test tests/*.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{ts,tsx,js,mjs,json,css,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,mjs,json,css,md}'",
    "verify:gas": "node scripts/verify-gas-config.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "mobx-state-tree": "^8.0.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
