{
  "name": "lotos-crm",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "dev:postgres": "node scripts/environment.mjs dev local",
    "auth:bootstrap:local": "node scripts/environment.mjs bootstrap local",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsc --target ES2020 --module commonjs --moduleResolution node --skipLibCheck --rootDir lib --outDir .test-dist lib/trainer-options.ts lib/attendance-recovery.ts lib/branch-selection.ts lib/formatters.ts lib/utils/date-core.ts lib/server/api-errors.ts lib/server/auth-user.ts lib/server/crm-read-cache.ts lib/server/policy.ts lib/server/content-security-policy.ts && node --test tests/*.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{ts,tsx,js,mjs,json,css,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,mjs,json,css,md}'",
    "verify:gas": "node scripts/verify-gas-config.mjs",
    "env:init": "node scripts/environment.mjs init",
    "env:check": "node scripts/environment.mjs check",
    "db:local:up": "node scripts/environment.mjs up local",
    "db:local:status": "node scripts/environment.mjs status local",
    "db:local:stop": "node scripts/environment.mjs stop local",
    "test:db": "node scripts/environment.mjs test test",
    "test:postgres": "node scripts/environment.mjs integration test",
    "test:auth:postgres": "node scripts/environment.mjs auth-test test",
    "test:domain:postgres": "node scripts/environment.mjs domain-test test",
    "test:auth:http": "node scripts/environment.mjs auth-http test",
    "test:auth:browser": "node scripts/environment.mjs auth-browser test",
    "test:operations:postgres": "node scripts/environment.mjs operations-test test",
    "db:generate": "node scripts/environment.mjs generate local",
    "db:validate": "node scripts/environment.mjs validate local",
    "db:migrate:local": "node scripts/environment.mjs migrate local",
    "documents:inspect:local": "node scripts/environment.mjs documents-inspect local",
    "import:dry-run": "python3 -B scripts/import-dry-run.py",
    "import:test:local": "node scripts/environment.mjs import-test local",
    "db:backup:local": "node scripts/backup-local.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "deploy:check": "node scripts/deployment-check.mjs",
    "cloud:check": "node scripts/cloud-check.mjs",
    "cloud:check:local": "node scripts/cloud-check.mjs local-env",
    "cloud:build": "npm run cloud:check && npm run build -- --webpack",
    "cloud:migrate": "node scripts/cloud-operator.mjs migrate",
    "cloud:status": "node scripts/cloud-operator.mjs status",
    "cloud:storage:init": "node scripts/cloud-operator.mjs storage-init",
    "cloud:verify": "node scripts/cloud-operator.mjs verify",
    "cloud:bootstrap": "node scripts/cloud-operator.mjs bootstrap",
    "cloud:bootstrap:sql": "node scripts/cloud-operator.mjs bootstrap-sql",
    "cloud:bootstrap:check": "node scripts/cloud-operator.mjs bootstrap-check",
    "test:infra:config": "node scripts/check-container-config.mjs",
    "hash-password": "node scripts/generate-scrypt-hash.mjs",
    "release:check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build -- --webpack",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/prisma-adapter": "1.7.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "mobx-state-tree": "^8.0.0",
    "next": "16.3.8",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
